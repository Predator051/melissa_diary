# Токен від @BotFather
BOT_TOKEN=123456:ABC...
# Дозволені користувачі (Telegram user id через кому). Порожньо = доступ закритий,
# бот покаже свій id кожному, хто напише — додай його сюди й перезапусти.
ALLOWED_USER_IDS=
# Розсилати оновлений розпорядок дня всім дозволеним користувачам (1/0)
BROADCAST=1
# Файл бази
DB_PATH=data/child_bot.db
